{
  "name": "room-overlay-card",
  "version": "1.0.7",
  "description": "Home Assistant Lovelace card for room visualization with image overlay layers, conditional transitions, clickable zones and embedded HA cards.",
  "keywords": ["home-assistant", "lovelace", "custom-card", "hacs"],
  "license": "MIT",
  "scripts": {
    "build": "npx esbuild src/room-overlay-card.ts --bundle --format=esm --outfile=room-overlay-card.js --sourcemap",
    "build:prod": "npx esbuild src/room-overlay-card.ts --bundle --format=esm --outfile=room-overlay-card.js --minify",
    "watch": "npx esbuild src/room-overlay-card.ts --bundle --format=esm --outfile=room-overlay-card.js --sourcemap --watch"
  },
  "dependencies": {
    "lit": "^3.1.4"
  },
  "devDependencies": {
    "esbuild": "^0.21.0",
    "typescript": "^5.4.5"
  }
}
